### Example environment variables for Silverback
# Copy this file to `.env` (do NOT commit `.env`)

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_PROJECT_NAME=hottboiihitzz

# GitHub
GITHUB_PAT=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_owner
GITHUB_REPO_NAME=silverback-flasher

# Application
FLASK_SECRET_KEY=replace_with_a_long_random_value
ADMIN_USER=admin
ADMIN_PASS=replace_with_secure_password

# Telegram
SILVERBACK_BOT_TOKEN=your_telegram_bot_token
SILVERBACK_ADMIN_CHAT_ID=your_admin_chat_id
